    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.3",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "workflow": "^5.5.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "prettier": "^3.10.1",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "overrides": {
