# Required for contextual review. Server-only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-4.1-2025-04-14
# Read-only token for private GitHub repositories. Never sent to the browser.
GITHUB_READ_TOKEN=
# Required for shared hosting. Unique random access keys, minimum 24 characters.
# Browser uses HTTP Basic authentication over HTTPS; no shared default password.
KENOBI_USERS={"your-email@example.com":"replace-with-a-long-random-access-key"}
KENOBI_ORIGIN=http://127.0.0.1:3000
# Required on Vercel: connect a private Neon/Postgres database and run npm run db:setup.
DATABASE_URL=
